# Database
DATABASE_URL=postgresql://moodlens:moodlens_dev@localhost:5432/moodlens

# Encryption (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your-generated-fernet-key-here

# JWT
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30

# Spotify API
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=moodlens://callback

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Background Jobs
INGESTION_INTERVAL_MINUTES=15
